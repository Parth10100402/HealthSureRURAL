{
  "name": "HS_Referral_Escalation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hs-referral-escalation",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "hs-referral-escalation-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Validate Referral Domain Event\nconst body = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    eventId: body.eventId,\n    eventType: body.eventType,\n    idempotencyKey: body.idempotencyKey,\n    payload: body.payload || {},\n    referralId: body.payload?.referralId,\n    priority: body.payload?.priority || 'NORMAL'\n  }\n}];"
      },
      "name": "Validate Referral Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "referral.created",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "referral.status_changed",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      },
      "name": "Switch by Referral Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipientId\": \"{{ $json.payload.receivingHospitalId }}\",\n  \"recipientRole\": \"HOSPITAL_STAFF\",\n  \"channel\": \"IN_APP\",\n  \"priority\": \"{{ $json.priority === 'URGENT' ? 'CRITICAL' : 'NORMAL' }}\",\n  \"type\": \"REFERRAL_INCOMING\",\n  \"title\": \"New Inbound Rural Referral [{{ $json.priority }}]\",\n  \"message\": \"Referral {{ $json.referralId }} received for {{ $json.payload.speciality }}. Please triage and assign OPD token within SLA threshold.\"\n}",
        "options": {}
      },
      "name": "Notify Hospital Triage Staff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/referrals/{{ $json.referralId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Check Referral SLA & Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.requiresEscalation }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Is SLA Breached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1380,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipientId\": \"admin-district-health\",\n  \"recipientRole\": \"ADMIN\",\n  \"channel\": \"IN_APP\",\n  \"priority\": \"CRITICAL\",\n  \"type\": \"REFERRAL_ESCALATED\",\n  \"title\": \"🚨 SLA BREACH ESCALATION: Referral {{ $json.data.referralId }}\",\n  \"message\": \"Rural clinical referral {{ $json.data.referralId }} ({{ $json.data.speciality }}) from {{ $json.data.referringFacilityName }} has exceeded the {{ $json.data.slaHours }}-hour response SLA. Immediate administrative escalation triggered.\"\n}",
        "options": {}
      },
      "name": "Trigger Admin SLA Escalation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipientId\": \"{{ $json.payload.patientId }}\",\n  \"recipientRole\": \"PATIENT\",\n  \"channel\": \"IN_APP\",\n  \"priority\": \"HIGH\",\n  \"type\": \"REFERRAL_STATUS_UPDATE\",\n  \"title\": \"Hospital Referral Status Update\",\n  \"message\": \"Your referral has been updated to {{ $json.payload.status }}. Assigned token: {{ $json.payload.tokenNumber || 'DH-CARD-14' }}.\"\n}",
        "options": {}
      },
      "name": "Notify Patient of Status Change",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        420
      ]
    }
  ],
