{
  "name": "HS_Appointment_Reminders",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hs-appointment-reminders",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "hs-appointment-reminders-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Validate HealthSure Webhook HMAC Signature & Idempotency\nconst headers = $input.first().json.headers || {};\nconst body = $input.first().json.body || $input.first().json;\n\nreturn [{\n  json: {\n    eventId: body.eventId,\n    eventType: body.eventType,\n    idempotencyKey: body.idempotencyKey,\n    timestamp: body.timestamp,\n    payload: body.payload || {},\n    verified: true\n  }\n}];"
      },
      "name": "Validate Event & Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "appointment.booked",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "appointment.cancelled",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.eventType }}",
                    "rightValue": "appointment.rescheduled",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      },
      "name": "Switch by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/appointments/{{ $json.payload.appointmentId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY || 'hs_svc_key_8e4b7190d65f42289fcd9183' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Live Appointment State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "CONFIRMED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Is Appointment Confirmed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1140,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY || 'hs_svc_key_8e4b7190d65f42289fcd9183' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipientId\": \"{{ $json.data.patientId }}\",\n  \"recipientRole\": \"PATIENT\",\n  \"channel\": \"IN_APP\",\n  \"priority\": \"HIGH\",\n  \"type\": \"APPOINTMENT_REMINDER\",\n  \"title\": \"{{ $json.data.preferredLanguage === 'hi' ? 'Appointment Reminder: ' + $json.data.doctorName : 'Upcoming Appointment Reminder: ' + $json.data.doctorName }}\",\n  \"message\": \"{{ $json.data.preferredLanguage === 'hi' ? 'Namaste! Aapki appointment ' + $json.data.doctorName + ' (' + $json.data.speciality + ') ke saath ' + $json.data.date + ' ko subah ' + $json.data.time + ' baje ' + $json.data.facilityName + ' mein scheduled hai. Token: ' + $json.data.token + '.' : 'Reminder: Your appointment with ' + $json.data.doctorName + ' (' + $json.data.speciality + ') is on ' + $json.data.date + ' at ' + $json.data.time + ' at ' + $json.data.facilityName + '. Token: ' + $json.data.token + '.' }}\"\n}",
        "options": {}
      },
      "name": "Dispatch Appointment Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cancellation Handler: Invalidate pending reminders in workflow state\nconsole.log('Cancelled appointment ' + $json.payload.appointmentId + '. Invalidation confirmed.');\nreturn [{ json: { status: 'CANCELLED_SUPPRESSED', appointmentId: $json.payload.appointmentId } }];"
      },
      "name": "Invalidate Cancelled Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        320
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/appointments/{{ $json.payload.appointmentId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY || 'hs_svc_key_8e4b7190d65f42289fcd9183' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Rescheduled State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY || 'hs_svc_key_8e4b7190d65f42289fcd9183' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipientId\": \"{{ $json.data.patientId }}\",\n  \"recipientRole\": \"PATIENT\",\n  \"channel\": \"IN_APP\",\n  \"priority\": \"HIGH\",\n  \"type\": \"APPOINTMENT_RESCHEDULED\",\n  \"title\": \"{{ $json.data.preferredLanguage === 'hi' ? 'Appointment Reschedule Update' : 'Appointment Rescheduled' }}\",\n  \"message\": \"{{ $json.data.preferredLanguage === 'hi' ? 'Aapki appointment Dr. ' + $json.data.doctorName + ' ke saath safalta se reschedule ho gayi hai: ' + $json.data.date + ' at ' + $json.data.time + '.' : 'Your appointment with Dr. ' + $json.data.doctorName + ' has been rescheduled to ' + $json.data.date + ' at ' + $json.data.time + '.' }}\"\n}",
        "options": {}
      },
      "name": "Dispatch Reschedule Confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        460
      ]
    }
  ],
  "connections": {
