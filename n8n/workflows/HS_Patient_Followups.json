{
  "name": "HS_Patient_Followups",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hs-patient-followups",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "hs-patient-followups-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Validate Consultation Event & Extract Follow-Up\nconst body = $input.first().json.body || $input.first().json;\nconst p = body.payload || {};\nreturn [{\n  json: {\n    eventId: body.eventId,\n    eventType: body.eventType,\n    idempotencyKey: body.idempotencyKey,\n    consultationId: p.consultationId,\n    patientId: p.patientId,\n    doctorId: p.doctorId,\n    speciality: p.speciality,\n    followUpDate: p.followUpDate,\n    followUpId: p.followUpId,\n    hasFollowUp: Boolean(p.hasFollowUp && p.followUpDate)\n  }\n}];"
      },
      "name": "Parse Follow-Up Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.hasFollowUp }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Has Valid Follow-Up Date?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/followups/{{ $json.followUpId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY || 'hs_svc_key_8e4b7190d65f42289fcd9183' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Follow-Up State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "UPCOMING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Is Follow-Up Upcoming?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1140,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HEALTHSURE_API_URL || 'https://healthsurerural.vercel.app' }}/api/service/notifications/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HealthSure-Service-Key",
              "value": "={{ $env.HEALTHSURE_SERVICE_API_KEY || 'hs_svc_key_8e4b7190d65f42289fcd9183' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipientId\": \"{{ $json.data.patientId }}\",\n  \"recipientRole\": \"PATIENT\",\n  \"channel\": \"IN_APP\",\n  \"priority\": \"NORMAL\",\n  \"type\": \"FOLLOWUP_REMINDER\",\n  \"title\": \"{{ $json.data.preferredLanguage === 'hi' ? 'Follow-Up Checkup Ki Suchna' : 'Scheduled Follow-Up Reminder' }}\",\n  \"message\": \"{{ $json.data.preferredLanguage === 'hi' ? 'Aapka follow-up checkup ' + $json.data.doctorName + ' (' + $json.data.speciality + ') ke saath ' + $json.data.dueDate + ' ko scheduled hai. Instructions: ' + $json.data.instructions : 'Your medical follow-up with ' + $json.data.doctorName + ' (' + $json.data.speciality + ') is due on ' + $json.data.dueDate + '. Instructions: ' + $json.data.instructions }}\"\n}",
        "options": {}
      },
      "name": "Send Follow-Up Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "// No follow-up scheduled by clinical officer - safe exit without reminder\nconsole.log('No clinical follow-up scheduled for consultation ' + $json.consultationId + '. Automation skipped.');\nreturn [{ json: { status: 'NO_FOLLOWUP_SKIPPED' } }];"
      },
      "name": "Skip Without Follow-Up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        380
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Parse Follow-Up Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Follow-Up Data": {
      "main": [
        [
          {
            "node": "Has Valid Follow-Up Date?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Valid Follow-Up Date?": {
      "main": [
        [
          {
            "node": "Fetch Follow-Up State",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip Without Follow-Up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Follow-Up State": {
      "main": [
        [
          {
            "node": "Is Follow-Up Upcoming?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Follow-Up Upcoming?": {
      "main": [
        [
          {
            "node": "Send Follow-Up Reminder",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}